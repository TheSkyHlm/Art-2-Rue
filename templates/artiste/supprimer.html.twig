{% extends 'base.html.twig' %}

{% block title %}Supprimer un artiste{% endblock %}

{% block body %}
    <h1>Supprimer un artiste</h1>
    <h2>Êtes-vous sûr de vouloir supprimer {{ artiste.pseudonyme }} ?</h2>
    {{ form(formulaire) }}
    <a href="{{ path("app_artiste") }}" class="btn btn-secondary mt-3">&lt; Retour à la liste des artistes</a>
{% endblock %}
